# Valores locales de desarrollo. No usar estas credenciales en produccion.
DB_USER=limber
DB_PASSWORD=123456
DB_NAME=bdcomplejodeportivo

# Cambiar por un secreto propio en entornos compartidos o productivos.
JWT_SECRET=local-only-change-before-deployment

# Opcionales: necesarios unicamente para funciones de correo.
EMAIL_USER=
EMAIL_PASS=

# Puertos publicados en el equipo local.
DB_PORT_HOST=5432
BACKEND_PORT_HOST=4000
FRONTEND_PORT=5173
PGADMIN_PORT=5050
VITE_API_URL=http://localhost:4000/api

# Credenciales locales para pgAdmin (perfil tools).
PGADMIN_EMAIL=admin@sports.local
PGADMIN_PASSWORD=admin_local